{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yatra/trip-map",
  "title": "Trip Map",
  "category": "yatra",
  "icon": "location-alt",
  "description": "Map of the trip's starting point and itinerary route.",
  "keywords": [
    "map",
    "location",
    "route",
    "yatra"
  ],
  "textdomain": "yatra",
  "attributes": {
    "tripId": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "yatra-trip-map-block-editor"
}
