{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yatra/trip-itinerary",
  "title": "Trip Itinerary",
  "category": "yatra",
  "icon": "calendar-alt",
  "description": "Day-by-day itinerary of a trip.",
  "keywords": [
    "itinerary",
    "days",
    "schedule",
    "yatra"
  ],
  "textdomain": "yatra",
  "attributes": {
    "tripId": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "yatra-trip-itinerary-block-editor"
}
