{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yatra/trip-reviews",
  "title": "Trip Reviews",
  "category": "yatra",
  "icon": "star-filled",
  "description": "Rating summary, reviews and review form of a trip.",
  "keywords": [
    "reviews",
    "rating",
    "testimonials",
    "yatra"
  ],
  "textdomain": "yatra",
  "attributes": {
    "tripId": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "yatra-trip-reviews-block-editor"
}
